# Runtime + URLs
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Postgres + Prisma connection
POSTGRES_USER=axion
POSTGRES_PASSWORD=axion_dev_password
POSTGRES_DB=auth_axion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://axion:axion_dev_password@localhost:5432/auth_axion?schema=public

# JWT secrets + TTLs
JWT_ACCESS_SECRET=replace_me_with_random_32_byte_base64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_with_a_DIFFERENT_random_32_byte_base64
JWT_REFRESH_EXPIRES_IN=7d

# Global rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Operational flags
ENABLE_CRON=true
REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth — all or none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth — all or none
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Mail delivery (smtp or resend)
MAIL_DRIVER=smtp
MAIL_FROM="Auth Axion <noreply@auth-axion.dev>"
MAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
MAIL_SMTP_PORT=2525
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# Resend (prod email delivery)
RESEND_API_KEY=
