{
  "name": "auth-axion-service",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone authentication service (NestJS) with a minimal Next.js demo frontend. Portfolio project.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @auth-axion/api dev",
    "dev:web": "pnpm --filter @auth-axion/web dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "lint:check": "pnpm --filter './apps/*' lint:check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "pnpm --filter './apps/*' typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "prisma:generate": "pnpm --filter @auth-axion/api prisma:generate",
    "prisma:migrate": "pnpm --filter @auth-axion/api prisma:migrate",
    "prisma:studio": "pnpm --filter @auth-axion/api prisma:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
